{
	"minTokens": 70,
	"minLines": 8,
	"threshold": 0,
	"reporters": ["console-full"],
	"ignore": [
		"**/node_modules/**",
		"**/.svelte-kit/**",
		"**/build/**",
		"**/coverage/**",
		"**/.wrangler/**",
		"**/*.test.*",
		"**/*.spec.*",
		"**/*.d.ts",
		"**/*.md",
		"**/src/lib/snapshot/generated/**",
		"**/src/test/fixtures/replies/**"
	]
}
