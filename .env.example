# Nebius Token Factory API key (https://tokenfactory.nebius.com). Read from this file only by a live
# capture run (--live with PAGEFIFTY_LIVE=1 in the shell).
NEBIUS_API_KEY=
# Tavily API key (https://tavily.com). Read from this file only by a live capture run (--live with
# PAGEFIFTY_LIVE=1 in the shell).
TAVILY_API_KEY=
# Read from the shell for one command (PAGEFIFTY_LIVE=1 npm run capture -- --live --cap N), never
# from this file. Metered calls stay off unless it is exactly 1.
PAGEFIFTY_LIVE=

# Knobs of the repo check scripts under scripts/, not settings the app reads.
# gate-ignore: CHECK_HUMAN_TODO_TIMEOUT_MS
# gate-ignore: GIT_STRIP_CANARY
# gate-ignore: LICENSE_HOLDER

# VITEST is set by vitest. vite.config.ts and scripts/preview.mjs set
# CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV and CLOUDFLARE_INCLUDE_PROCESS_ENV to false in every dev,
# preview, build and test run. Never this file.
# gate-ignore: VITEST CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV CLOUDFLARE_INCLUDE_PROCESS_ENV
