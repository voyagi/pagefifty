# Nebius Token Factory API key (https://tokenfactory.nebius.com). Only read when PAGEFIFTY_LIVE=1.
NEBIUS_API_KEY=
# Tavily API key (https://tavily.com). Only read when PAGEFIFTY_LIVE=1.
TAVILY_API_KEY=
# Metered calls stay off unless this is exactly 1. Anything else replays recorded snapshots.
PAGEFIFTY_LIVE=

# Knobs of the repo check scripts under scripts/, not settings the app reads.
# gate-ignore: CHECK_HUMAN_TODO_TIMEOUT_MS
# gate-ignore: GIT_STRIP_CANARY
# gate-ignore: LICENSE_HOLDER
