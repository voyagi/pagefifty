	<cac:ProcurementProject>
		<cbc:ID schemeName="internalID">2026/22</cbc:ID>
		<cbc:Name languageID="DEU">Nachbeschaffung von Lizenzen und Support von virtuellen Proofpoint Protection Servern als Email Gateway im Rechenzentrum der Finanzverwaltung</cbc:Name>
		<cbc:Description languageID="DEU">33.000 Software-Lizenzen der Firma Proofpoint Incorporated inkl. 4 Jahre Support und Softwarepflege.</cbc:Description>
		<cbc:ProcurementTypeCode listName="contract-nature">supplies</cbc:ProcurementTypeCode>
