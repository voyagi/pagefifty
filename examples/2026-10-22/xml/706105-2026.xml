                                        </efac:AwardCriterionParameter>
                                    </efext:EformsExtension>
                                </ext:ExtensionContent>
                            </ext:UBLExtension>
                        </ext:UBLExtensions>
                        <cbc:AwardingCriterionTypeCode languageID="NLD" listName="award-criterion-type">quality</cbc:AwardingCriterionTypeCode>
                        <cbc:Name languageID="NLD">Aanbodmanagement</cbc:Name>
                        <cbc:Description languageID="NLD">De gemeenteraden van de gemeenten Veenendaal, Rhenen en Renswoude hechten veel belang aan keuzevrijheid voor Pashouders. Dit vraagt een actieve rol van inschrijver rol in het aantrekken en behouden van aanbieders.</cbc:Description>
                    </cac:SubordinateAwardingCriterion>
