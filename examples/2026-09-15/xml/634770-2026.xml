         <ext:UBLExtensions>
            <ext:UBLExtension>
               <ext:ExtensionContent>
                  <efext:EformsExtension>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-stand-to-spec</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Umsatz des Unternehmens in den letzten drei abgeschlossenen Geschäftsjahren - alternativ seit Bestehen -, soweit er Leistungen betrifft, die mit der zu vergebenen Leistung vergleichbar sind, unter Einschluss des Anteils der gemeinsam mit anderen Unternehmen ausgeführten Leistungen.
Der jährliche Umsatz für vergleichbare Leistungen muss mindestens 2 Mio € (netto) betragen. </cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-mgmt-qual</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Angaben zu einem Qualitätsmanagementsystem
gültige Zertifizierung nach ISO 9001 oder einer gleichwertigen Bescheinigung von Stellen aus anderen EU-Mitgliedstaaten</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-tech-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Angaben zu IT Service Management 
gültige Zertifizierung nach ISO 20000 oder einer gleichwertigen Bescheinigung von Stellen aus anderen EU-Mitgliedstaaten. </cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-tech-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Die Erbringung der Leistungen wird in besonders gesicherten Räumlichkeiten des Auftraggebers stattfinden. Das vom Auftragnehmer eingesetzte Personal, sowie das von beauftragen weiteren Firmen, welches Zutritt zu diesen Räumlichkeiten der Standorte benötigt muss über eine abgeschlossene erweiterte Sicherheitsüberprüfung im vorbeugenden personellem Sabotageschutz gemäß Sicherheitsüberprüfungsgesetz (SÜG) verfügen, die zum Ergebnis hat, dass kein Sicherheitsrisiko vorliegt.</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-tech-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der Auftraggeber stellt innerhalb von 14 Tagen nach Zuschlagserteilung die Liste der Mitarbeiter zur Verfügung, die eingesetzt und durch den Auftraggeber im vorbeugenden personellen Sabotageschutz überprüft werden sollen.</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-tech-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der AN informiert den AG unverzüglich über Personalveränderungen hinsichtlich der Sicherheitsüberprüfung.</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-mgmt-qual</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der Auftragnehmer muss über den Partnerstatus (z.B. Platin, Gold oder Silber oder vergleichbar) zu dem /den Hersteller(n) im Rahmen einer Umsetzung zum Einsatz kommenden Netzwerkkomponenten verfügen. Hinweis an Bieter: Bitte entsprechenden Partnerstatus in Spalte F benennen.</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-tech-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der Auftragnehmer muss während der Vertragslaufzeit ausreichend deutschsprachiges (fließend in Wort und Schrift, mindestens B2 nach GER) Personal in den Bereichen Vertrieb, Wartung/Support und technische Beratung, welche für die Leistungserbringung nötig sind und direkten Kundenkontakt haben, zur Verfügung stellen.</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-tech-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der Auftragnehmer muss während der Vertragslaufzeit ausreichend deutschsprachige (fließend in Wort und Schrift, mindestens B2 nach GER) Mitarbeitende für die Bereiche Wartung/Support und technische Beratung zur Verfügung stellen, die über eine aktive Grund-Zertifizierung (z.B. Cisco Certified Network Technician CCT oder vergleichbar) für die von ihnen im Rahmen eines Angebots eingesetzten aktiven Komponenten durch den Hersteller eben dieser verfügen.</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-tech-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der Auftragnehmer muss während der Vertragslaufzeit mindestens jeweils einen deutschsprachigen (fließend in Wort und Schrift, mindestens B2 nach GER), Mitarbeitenden, der über eine aktive Zertifizierung auf Expertenniveau (z.B. Cisco Certified Internetwork Expert CCIE oder vergleichbar), im Bereich Wartung/Support und technische Beratung zur Verfügung stellen.</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-tech-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der Auftragnehmer muss während der Vertragslaufzeit mindestens drei deutschsprachige (fließend in Wort und Schrift, mindestens B2 nach GER) Mitarbeitende, die über eine aktive Zertifizierung auf professionellem Niveau (z.B. Cisco Certified Network Associate CCNA bzw. Cisco Certified Network Professional CCNP oder vergleichbar), im Bereich Wartung/Support und technische Beratung zur Verfügung stellen</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-ref-services</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Beschreibung von 3 Referenzen mit den folgenden Mindestanforderungen:
(als Stichtag gilt der Veröffentlichungstermin dieses Vergabeverfahrens)
Mindestanforderungen Vertragsverhältnis:
Ein konkretes Vertragsverhältnis, welches mit der zu vergebenen Leistung (fachlich und inhaltlich) vergleichbar ist. 
Zeitliche Mindestanforderungen: 
Die Leistungen des Referenzprojektes wurden innerhalb der letzten 5 Jahre erbracht.
Die Laufzeit des Referenzprojektes muss mindestens 1 Jahr betragen haben.
Es können nur Zeiträume herangezogen werden, in denen tatsächlich eine Leistungserbringung erfolgte.
Mindestanforderungen Vergleichbarkeit der technischen Anforderungen:
Die Vergleichbarkeit der technischen Anforderungen ist bei mindestens 30 Standorten auf Basis eines Ethernet Netzwerk gegeben. 
Bei andauernden Referenzprojekten ist der Anteil der bis zum Stichtag tatsächlich erbrachten Leistungen anzugeben.
Mindestanforderungen Vergleichbarkeit des Vertragsvolumens:
Die Vergleichbarkeit des Volumens ist bei 500.000 € / Jahr gegeben.
Bei andauernden Referenzprojekten ist der Anteil der bis zum Stichtag tatsächlich erbrachten Leistungen anzugeben. 
</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-suit-reg-trade</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Eigenerklärung (gem. Ziffer 4, Dokument_Eigenerklärung Eignung) über die Eintragung im Berufsregister mit Angabe der Registernummer, ggf. Kopie der Eintragung beifügen (in der Bundesrepublik Deutschland Handelsregister bzw. Handwerksrolle, bei ausländischen Bewerbern Unterlagen gemäß Artikel 58 der Richtlinie 2014/24/EG</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-stand-other</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Angaben zu Insolvenzverfahren und Liquidation (gem. Ziffer 5, Vordruck_Eigenerklärung_Eignung)</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-stand-other</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Eigenerklärung Versicherungen
Die Deckungssumme beträgt mindestens für Bearbeitungsschäden 3.000.000,00 Euro, für Sachschäden 3.000.000 Euro und für Vermögensschäden 3.000.000 Euro. Die Gesamtleistung für alle Versicherungsfälle eines Jahres beträgt das Zweifache dieser Deckungssummen (gem. Dokument_Eigenerklärung Eignung).</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-stand-other</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Keine schwere Verfehlung
Angaben, dass nachweislich keine schwere Verfehlung begangen wurde, die die Zuverlässigkeit als Bewerber/Bieter in Frage stellt (gem. Ziffer 7, Vordruck_Eigenerklärung_Eignung)</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-stand-other</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Zahlung von Steuern
Angaben zur Zahlung von Steuern, Abgaben und Beiträgen zur gesetzlichen Sozialversicherung (gem. Ziffer  8, Vordruck_Eigenerklärung_Eignung) Ggf. Vorlage einer Unbedenklichkeitsbescheinigung des Finanzamtes.</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-suit-auth-mbrshp</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Mitgliedschaft bei der Berufsgenossenschaft
Angaben zur Mitgliedschaft bei der Berufsgenossenschaft (gem. Ziffer 9, Vordruck_Eigenerklärung_Eignung)</cbc:Description>
                     </efac:SelectionCriteria>
                     <efac:StrategicProcurement>
                        <efbc:ApplicableLegalBasis listName="cvd-scope">false</efbc:ApplicableLegalBasis>
                     </efac:StrategicProcurement>
                  </efext:EformsExtension>
