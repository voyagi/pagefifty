                           <efbc:ParameterNumeric>18</efbc:ParameterNumeric>
                        </efac:CriterionParameter>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-ref-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Referenzen mit Wasser/Abwasser/Energie oder vergleichbarer hoher Versorgungsrelevanz.</cbc:Description>
