                  <efext:EformsExtension>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-stand-ins</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Mindestdeckung für Personen-, Sach- und Vermögensschäden von jeweils 2 Mio. EUR</cbc:Description>
                        <efbc:SecondStageIndicator>false</efbc:SecondStageIndicator>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-stand-to-spec</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der Bewerber hat einen durchschnittlichen Jahresumsatz der letzten drei abgeschlossenen Geschäftsjahre nachzuweisen, der sich auf Leistungen im Bereich der Automatisierungs-, Prozessleit-, Elektro- und industriellen Netzwerktechnik bezieht. Der Umsatz muss erkennen lassen, dass der Bewerber über ausreichende wirtschaftliche und finanzielle Leistungsfähigkeit zur Durchführung des Auftrags verfügt.</cbc:Description>
                        <efbc:SecondStageIndicator>false</efbc:SecondStageIndicator>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-qual-inst</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Der Bewerber hat seine besondere Befähigung zur Planung, Projektierung, Programmierung und Inbetriebnahme von Siemens-Automatisierungs- und Visualisierungssystemen nachzuweisen. Hierzu ist eine gültige Siemens Solution Partner Zertifizierung im Bereich Industrial Automation oder ein gleichwertiger Qualifikationsnachweis für die ausgeschriebene Systemplattform vorzulegen. Weiterhin ist ein gültiges Zertifikat nach DIN EN ISO/IEC 27001 oder ein vergleichbarer Nachweis eines etablierten Informationssicherheitsmanagementsystems vorzulegen.</cbc:Description>
                        <efbc:SecondStageIndicator>false</efbc:SecondStageIndicator>
                     </efac:SelectionCriteria>
                     <efac:SelectionCriteria>
                        <cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-ref-work</cbc:TendererRequirementTypeCode>
                        <cbc:Description languageID="DEU">Zusätzliche vergleichbare Referenzen</cbc:Description>
                        <efbc:SecondStageIndicator>true</efbc:SecondStageIndicator>
                        <efac:CriterionParameter>
